@page
@model EmployeesModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Employees Management";
}

<h1>@ViewData["Title"]</h1>

<h2>Users &nbsp;<i class="bi bi-people-fill h4"></i> </h2>

<div class="container overflow-x-auto col-12">
    <table id="tblData" class="table table-bordered table-striped col-12">
        <thead>
            <tr>
                <th class="text-center">Department</th>
                <th class="text-center">Full Name</th>
                <th class="text-center">Birthday</th>
                <th class="text-center">EmployedFrom</th>
                <th class="text-center">Salary</th>
                <th class="text-center"></th>
            </tr>
        </thead>

    </table>
</div>

<div class="container d-flex justify-content-end mt-3">
    <button type="button" class="btn btn-secondary" onclick="openEmployeeModal()">
        Add new
    </button>
</div>

<div id="employeeModalContainer"></div>

<form method="post">
    <input name="__RequestVerificationToken" type="hidden" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
</form>

@section Scripts {
    <script type="text/javascript" asp-append-version="true" src="//cdn.datatables.net/2.3.1/js/dataTables.min.js"></script>
    <script type="text/javascript">
        const employeeDataUrl = '@Url.Page("Employees", "Employees")';
        const employeeDeleteUrl = '@Url.Page("Employees", "Delete")';
        
        
        function openEmployeeModal(id = null) {
            const url = id
                ? '@Url.Page("Employees", "LoadEmployeeModal")' + '?id=' + id
                : '@Url.Page("Employees", "LoadEmployeeModal")';

            $.get(url, function(html) {
                $('#employeeModalContainer').html(html);
                const modal = new bootstrap.Modal(document.getElementById('employeeModal'));
                modal.show();
            });
        }


        $(document).on('submit', '#employeeForm', function(e) {
            e.preventDefault();

            const formData = {
                Id: $('input[name="Id"]').val(),
                FullName: $('input[name="FullName"]').val(),
                Birthday: $('input[name="Birthday"]').val(),
                Salary: parseFloat($('input[name="Salary"]').val()),
                StartedFrom: $('input[name="StartedFrom"]').val(),
                EndedAt: $('input[name="EndedAt"]').val() || null,
                PositionId: $('select[name="PositionId"]').val().toLowerCase()
            };

            const isUpdate = formData.Id && formData.Id !== '00000000-0000-0000-0000-000000000000';

            const url = isUpdate ? '@Url.Page("Employees", "Update")' : '@Url.Page("Employees", "Create")';

            $.ajax({
                url: url,
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function(response) {
                    $('#employeeModal').modal('hide');
                    alert('Employee saved successfully.');
                },
                error: function(xhr) {
                    alert('Something went wrong. Please try again.');
                    console.error(xhr.responseText);
                }
            });
        });
    </script>



   


    <script type="text/javascript" asp-append-version="true" src="~/js/users.js" ></script>
}




@page
@model EmployeesModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = "Employees Management";
}

<h1>@ViewData["Title"]</h1>

<h2>Users &nbsp;<i class="bi bi-people-fill h4"></i> </h2>

<div class="container overflow-x-auto col-12">
    <table id="tblData" class="table table-bordered table-striped col-12">
        <thead>
            <tr>
                <th class="text-center">Department</th>
                <th class="text-center">Full Name</th>
                <th class="text-center">Birthday</th>
                <th class="text-center">EmployedFrom</th>
                <th class="text-center">Salary</th>
                <th class="text-center"></th>
            </tr>
        </thead>

    </table>
</div>

<div class="container d-flex justify-content-end mt-3">
    <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#createEmployeeModal">
        Add new
    </button>
</div>

<div class="modal fade" id="createEmployeeModal" tabindex="-1" aria-labelledby="createEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <form method="post" asp-page-handler="Create" id="createEmployeeForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="employeeModalLabel">Add New Employee</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label asp-for="CreateInput.FullName" class="form-label"></label>
                            <input asp-for="CreateInput.FullName" class="form-control" />
                            <span asp-validation-for="CreateInput.FullName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="CreateInput.Birthday" class="form-label"></label>
                            <input asp-for="CreateInput.Birthday" type="date" class="form-control" />
                            <span asp-validation-for="CreateInput.Birthday" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="CreateInput.Salary" class="form-label"></label>
                            <input asp-for="CreateInput.Salary" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="CreateInput.Salary" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="CreateInput.StartedFrom" class="form-label"></label>
                            <input asp-for="CreateInput.StartedFrom" type="date" class="form-control" />
                            <span asp-validation-for="CreateInput.StartedFrom" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="CreateInput.EndedAt" class="form-label"></label>
                            <input asp-for="CreateInput.EndedAt" type="date" class="form-control" />
                            <span asp-validation-for="CreateInput.EndedAt" class="text-danger"></span>
                        </div>
                        <select asp-for="CreateInput.PositionId" class="form-select" asp-items="Model.PositionOptions">
                            <option value="">-- Select Position --</option>
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="updateEmployeeModal" tabindex="-1" aria-labelledby="updateEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-body">
                <form method="post" asp-page-handler="Update" id="updateEmployeeForm">
                    <div class="modal-header">
                        <h5 class="modal-title" id="employeeModalLabel">Update Employee</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <input asp-for="UpdateInput.Id" id="editEmployeeId" class="form-control" hidden />
                        <div class="mb-3">
                            <label  class="form-label"></label>
                            <input  id="editFullName" class="form-control" />
                            <span asp-validation-for="UpdateInput.FullName" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label  class="form-label"></label>
                            <input  type="date" id="editBirthday" class="form-control" />
                            <span asp-validation-for="UpdateInput.Birthday" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label  class="form-label"></label>
                            <input  type="number" step="0.01" id="editSalary" class="form-control" />
                            <span   class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label  class="form-label"></label>
                            <input  type="date" id="editStartedFrom" class="form-control" />
                            <span  class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label  class="form-label"></label>
                            <input  type="date" id="editEndedAt" class="form-control" />
                            <span   class="text-danger"></span>
                        </div>
                        <select  id="editPositionId" class="form-select" asp-items="Model.PositionOptions">
                            <option value="">-- Select Position --</option>
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<form method="post">
    <input name="__RequestVerificationToken" type="hidden" value="@Antiforgery.GetAndStoreTokens(HttpContext).RequestToken" />
</form>

@section Scripts {
    <script type="text/javascript" asp-append-version="true" src="//cdn.datatables.net/2.3.1/js/dataTables.min.js"></script>
    <script type="text/javascript">
        const employeeDataUrl = '@Url.Page("Employees", "Employees")';
        const employeeDeleteUrl = '@Url.Page("Employees", "Delete")';
        
        $('#createEmployeeForm').submit(function (e) {
            e.preventDefault();
            const formData = getFormDataAsObject($(this));
            $.ajax({
                url: '@Url.Page("Employees","Create")',
                type: 'POST',
                data: JSON.stringify(formData),
                success: function (data) {
                    if (data.success) {
                        alert('Employee created!');
                        $('#createEmployeeModal').modal('hide')
                        $('#tblData').DataTable().ajax.reload();
                    } else {
                        alert('Error: ' + data.message);
                    }
                }
            });
        });

        $('#editEmployeeForm').submit(function (e) {
            e.preventDefault();
            const formData = getFormDataAsObject($(this));
            $.ajax({
                url: '@Url.Page("Employees", "Update")',
                type: 'POST',
                data: JSON.stringify(formData),
                success: function (data) {
                    if (data.success) {
                        alert('Employee updated!');
                        $('#editEmployeeModal').modal('hide')
                        $('#tblData').DataTable().ajax.reload();
                    } else {
                        alert('Error: ' + data.message);
                    }
                }
            });
        });

    </script>
    <script type="text/javascript" asp-append-version="true" src="~/js/users.js" ></script>
}



